{
  "name": "emad-portfolio-nextjs",
  "version": "1.0.0",
  "private": true,
  "description": "Emad's responsive quantum research portfolio, built with Next.js, TypeScript and Tailwind CSS.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "node scripts/preview.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "postbuild": "node scripts/finalize-export.mjs",
    "preview": "node scripts/preview.mjs"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "postcss": "^8.5.0",
    "tailwindcss": "4.1.18",
    "typescript": "~5.9.3"
  }
}
